PORT=3000
NODE_ENV=development

# 🌐 Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# 🍃 MongoDB Atlas Cloud Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.rkqchpt.mongodb.net/employee_management?retryWrites=true&w=majority

# 🔐 JWT Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# 👑 Super Admin Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminPassword@123

# ✉️ Nodemailer Email Credentials (Gmail SMTP App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password